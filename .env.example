AUTHORITY_PORT=4100
AUTHORITY_URL=http://127.0.0.1:4100
AUTHORITY_DB_PATH=./authority.sqlite
SUPPLIER_URL=http://127.0.0.1:4200
SUPPLIER_PORT=4200
SUPPLIER_DB_PATH=./supplier.sqlite
# Supplier's private Postgres (Supabase transaction pooler, `supplier` schema). When set, it is used
# instead of SUPPLIER_DB_PATH. Replace [YOUR-PASSWORD] (URL-encoded); never commit the real value.
SUPPLIER_DATABASE_URL=postgresql://postgres.ebkcaqaybuklllefvuyv:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Set a separate random shared backend secret in both authority and supplier services.
SUPPLIER_SERVICE_KEY=
# npm run seed:authority securely provisions these four keys into untracked .env.
OWNER_API_KEY=
BUYER_API_KEY=
SOURCING_API_KEY=
SUPPLIER_API_KEY=
# For each stdio MCP host, select only that agent's provisioned key.
AGENT_API_KEY=

# Manufact embedded authority: use Supabase's private PostgreSQL session-pooler URL.
# Leave AUTHORITY_URL unset in the hosted app when DATABASE_URL is set.
DATABASE_URL=
# Optional PEM CA certificate if the database certificate needs a custom trust root.
DATABASE_CA_CERT=
# Separate authority hosting can bind to 0.0.0.0; default remains loopback.
AUTHORITY_HOST=127.0.0.1

# Optional browser console; both values are required to mount it on the MCP app.
CONSOLE_ORIGIN=
MCP_PUBLIC_URL=
# Absolute apps/dashboard/public directory when the runtime cwd is not the repo root.
CONSOLE_ASSETS_DIR=
CONSOLE_PORT=3000

# Optional self-service OAuth/consent. Configure through private deployment env;
# leave these absent for legacy service-agent-only operation. See docs/21-SELF-SERVICE-ROLLOUT.md.
# MCP_USE_OAUTH_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_<public project key>
# AGENTPASS_OAUTH_CLIENT_IDS=approved-chatgpt-client,approved-claude-client
# AGENTPASS_OAUTH_REDIRECT_URIS=["https://approved-host.example/oauth/callback"]
# AGENTPASS_CONSENT_CLIENT_ID=separate-first-party-client
# AGENTPASS_CONSENT_CLIENT_SECRET=<private secret manager value>
# AGENTPASS_CONSENT_SESSION_KEY=<64 lowercase hex characters from a private random generator>
# AGENTPASS_ONBOARDING_SUPPLIER_IDS=["supplier-co"]
# AGENTPASS_ONBOARDING_SKU_IDS=["PACK-500"]
# AGENTPASS_ONBOARDING_MAX_BUDGET_CENTS=0
# AGENTPASS_ONBOARDING_MAX_PER_ACTION_CENTS=0
# AGENTPASS_CREDENTIAL_STORE=vault
# AGENTPASS_RUNNERS_JSON=[{"id":"trusted-sourcing","keyHash":"<SHA-256 verifier>","organizationIds":[]}]
# AGENTPASS_ONBOARDING_RUNNER_ID=trusted-sourcing

# Optional workforce gateway (B-owned runtime). Configure all three together.
# No resource, endpoint or root authority is inferred from model input.
WORKFORCE_RESOURCES_JSON=
WORKFORCE_GATEWAY_URL=
WORKFORCE_SERVICE_KEY=
# Trusted administrator CLI only; no HTTP/MCP root-issuance tool.
WORKFORCE_ROOT_JSON=
