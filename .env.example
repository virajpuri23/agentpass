# Copy to .env with `npm run keys` (generates random keys). Never commit .env.

# Ports / URLs
AUTHORITY_PORT=4100
AUTHORITY_BASE_URL=http://localhost:4100
SUPPLIER_PORT=4200
SUPPLIER_BASE_URL=http://localhost:4200

# Storage
AUTHORITY_DB_PATH=data/authority.db
SUPPLIER_DB_PATH=data/supplier.db

# Agent API keys: one per principal, sent as `Authorization: Bearer <key>`
OWNER_API_KEY=
BUYER_AGENT_API_KEY=
SOURCING_AGENT_API_KEY=
SUPPLIER_AGENT_API_KEY=
ADMIN_API_KEY=

# Authority -> supplier backend credential (`X-Service-Key`). Never given to agents.
SUPPLIER_SERVICE_KEY=

# How agents reach AgentPass: fake (in-memory, dev only) | http | mcp
AUTHORITY_MODE=fake
