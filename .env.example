AUTHORITY_PORT=4100
AUTHORITY_URL=http://127.0.0.1:4100
AUTHORITY_DB_PATH=./authority.sqlite
SUPPLIER_URL=http://127.0.0.1:4200
# Set a separate random shared backend secret in both authority and supplier services.
SUPPLIER_SERVICE_KEY=
# npm run seed:authority securely provisions these four keys into untracked .env.
OWNER_API_KEY=
BUYER_API_KEY=
SOURCING_API_KEY=
SUPPLIER_API_KEY=
# For each stdio MCP host, select only that agent's provisioned key.
AGENT_API_KEY=

# Manufact embedded authority: use Supabase's private PostgreSQL session-pooler URL.
# Leave AUTHORITY_URL unset in the hosted app when DATABASE_URL is set.
DATABASE_URL=
# Optional PEM CA certificate if the database certificate needs a custom trust root.
DATABASE_CA_CERT=
# Separate authority hosting can bind to 0.0.0.0; default remains loopback.
AUTHORITY_HOST=127.0.0.1
