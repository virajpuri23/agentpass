  "include": ["apps/cli/**/*.ts", "apps/dashboard/**/*.ts", "apps/authority/**/*.ts", "apps/mcp/**/*.ts", "db/**/*.ts", "packages/contracts/**/*.ts",
    "apps/supplier/**/*.ts", "apps/buyer-agent/**/*.ts", "apps/sourcing-agent/**/*.ts", "apps/remote/**/*.ts", "scripts/**/*.ts"]
}
