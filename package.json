{
  "name": "agentpass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "keys": "tsx scripts/gen-keys.ts",
    "dev:authority": "tsx apps/authority/src/server.ts",
    "dev:supplier": "tsx --env-file-if-exists=.env apps/supplier/src/server.ts",
    "dev:mcp": "tsx apps/mcp/src/server.ts",
    "demo:reset": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "demo:run": "tsx --env-file-if-exists=.env scripts/run-e2e.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
